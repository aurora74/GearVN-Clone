{
  "name": "api-gearvn",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "seed:admin": "node scripts/seed-admin.js",
    "profile:crawl-products": "ts-node -r tsconfig-paths/register scripts/profile-crawl-products.ts",
    "import:crawl-products": "ts-node -r tsconfig-paths/register scripts/import-crawl-products.ts",
    "index:products:qdrant": "ts-node -r tsconfig-paths/register scripts/index-products-qdrant.ts",
    "benchmark:product-retrieval": "ts-node -r tsconfig-paths/register scripts/benchmark-product-retrieval.ts",
    "benchmark:phase10-retrieval": "ts-node -r tsconfig-paths/register scripts/benchmark-product-retrieval.ts",
    "audit:retrieval-qrels": "ts-node -r tsconfig-paths/register scripts/audit-product-retrieval-qrels.ts",
    "assistant:smoke:live": "ts-node -r tsconfig-paths/register src/ai/assistant/scripts/live-agent-smoke.ts",
    "seed:verified-chat-customer": "ts-node -r tsconfig-paths/register scripts/seed-verified-chat-customer.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@arizeai/phoenix-otel": "^1.0.1",
    "@langchain/core": "1.1.45",
